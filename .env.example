DATABASE_URL=postgresql+asyncpg://livepulse:livepulse@localhost:5432/livepulse
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_URL=/api
# For LAN testing in Dokploy: WEB_BIND=192.168.1.50 and WEB_PORT=8090.
WEB_BIND=127.0.0.1
WEB_PORT=8080
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=["http://localhost:8443","http://localhost:8080"]
# Roles: Clerk > Sessions > Customize session token: {"metadata": "{{user.public_metadata}}"}
# Optional fallback while that is not configured (never a VITE_* variable):
# CLERK_SECRET_KEY=sk_live_...
CORS_ORIGINS=["http://localhost:8443","http://localhost:8080"]
TIKTOK_ACCOUNTS={"medical": "medical.cirugias", "medical-2": "medical.cirugias2"}

# IDs de administradores iniciales tras registrarlos en Clerk
ADMIN_USER_IDS=[]
# Secreto exclusivo del puente Medical 360 (no es una clave pública)
MEDICAL360_TOKEN=

# Medical Social Live <-> Medical 360 (ver docs/social-live-api.md)
SOCIAL_LIVE_TOKEN=
MEDICAL360_EXPORT_TOKEN=
COMMENTS_RETENTION_DAYS=30

# Alertas: minutos que deben pasar desde que se marcó "contactado" para que un nuevo
# comentario con el mismo número en el MISMO live sea sospechoso, y recordatorios al agente.
ALERT_SAME_LIVE_MINUTES=10
REMINDER_FIRST_MINUTES=10
REMINDER_SECOND_MINUTES=20

# Reparto automático de contactos nuevos entre los agentes conectados (ver docs/social-live-api.md).
# false = los agentes toman los contactos libres ellos mismos.
AUTO_ASSIGNMENT=true
# Segundos sin latido para considerar desconectado a un agente, y espera extra antes de
# repartir a los demás lo que tenía pendiente.
PRESENCE_OFFLINE_AFTER_S=60
REDISTRIBUTE_GRACE_S=60

# Automatización (flujos, agente de IA, difusiones; ver docs/automatizacion-ia-masivos.md).
# Clave Fernet que cifra las claves guardadas desde la pantalla (proveedor de IA). Genérala una
# sola vez, igual que la de TikTok, y respáldala aparte de la base de datos.
APP_ENCRYPTION_KEY=
# Horas que el bot se calla en una conversación después de que una persona escribe en ella.
BOT_PAUSE_HOURS=6

# Espejo WhatsApp (opcional). Habilitar COMPOSE_PROFILES=live,whatsapp.
# Generar DOS secretos distintos con: python -c "import secrets; print(secrets.token_hex(32))"
# Mantenerlos estables; respaldar WA_SESSION_KEY separado del volumen wa-session.
WA_GATEWAY_TOKEN=
WA_SESSION_KEY=
# Número empresarial autorizado, con código de país. Ejemplo de formato: +519XXXXXXXX
WA_EXPECTED_PHONE=
WA_GATEWAY_URL=http://wa-gateway:3001

# TikTok API for Business: advertiser OAuth (see docs/tiktok-oauth.md).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://livepulse.reporte.help/api/integrations/tiktok/callback
# Generate once with Fernet.generate_key(); keep stable and back it up separately from DB.
TIKTOK_TOKEN_ENCRYPTION_KEY=
