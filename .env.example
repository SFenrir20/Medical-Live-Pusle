DATABASE_URL=postgresql+asyncpg://livepulse:livepulse@localhost:5432/livepulse
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
VITE_API_URL=/api
# For LAN testing in Dokploy: WEB_BIND=192.168.1.50 and WEB_PORT=8090.
WEB_BIND=127.0.0.1
WEB_PORT=8080
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=["http://localhost:8443","http://localhost:8080"]
# Roles: Clerk > Sessions > Customize session token: {"metadata": "{{user.public_metadata}}"}
# Optional fallback while that is not configured (never a VITE_* variable):
# CLERK_SECRET_KEY=sk_live_...
CORS_ORIGINS=["http://localhost:8443","http://localhost:8080"]
TIKTOK_ACCOUNTS={"medical": "medical.cirugias", "medical-2": "medical.cirugias2"}

# IDs de administradores iniciales tras registrarlos en Clerk
ADMIN_USER_IDS=[]
# Secreto exclusivo del puente Medical 360 (no es una clave pública)
MEDICAL360_TOKEN=

# Medical Social Live <-> Medical 360 (ver docs/social-live-api.md)
SOCIAL_LIVE_TOKEN=
MEDICAL360_EXPORT_TOKEN=
COMMENTS_RETENTION_DAYS=30

# Alertas: minutos que deben pasar desde que se marcó "contactado" para que un nuevo
# comentario con el mismo número en el MISMO live sea sospechoso, y recordatorios al agente.
ALERT_SAME_LIVE_MINUTES=10
REMINDER_FIRST_MINUTES=10
REMINDER_SECOND_MINUTES=20

# TikTok API for Business: advertiser OAuth (see docs/tiktok-oauth.md).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=https://livepulse.reporte.help/api/integrations/tiktok/callback
# Generate once with Fernet.generate_key(); keep stable and back it up separately from DB.
TIKTOK_TOKEN_ENCRYPTION_KEY=
